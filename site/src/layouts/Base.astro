---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  faqItems?: Array<{ question: string; answer: string }>;
  schemaItems?: Array<Record<string, unknown>>;
  markdownPath?: string;
  skipHref?: string;
  skipLabel?: string;
  noindex?: boolean;
}
const {
  title = 'Clarity: AI writing skill and editor | Addy Osmani',
  description =
    'An open-source writing skill for AI agents and a private browser editor for clearer, more human prose without invented facts or flattened voice.',
  ogImage = '/og.png',
  ogImageAlt = 'Clarity - writing that earns its reader. Eighteen rules and an Agent Skill for stronger prose.',
  faqItems = [],
  schemaItems = [],
  markdownPath,
  skipHref = '#rules',
  skipLabel = 'Skip to the rules',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://clarity.addy.ie');
const ogImageUrl = new URL(ogImage, canonical);
const resolvedMarkdownPath = markdownPath ??
  (Astro.url.pathname === '/' ? '/index.md' : `${Astro.url.pathname.replace(/\/$/, '')}/index.md`);
const productDescription =
  'An open-source Agent Skill and private browser editor for writing that is useful, clear, and recognisably the author\'s own.';
const pageId = `${canonical.href}#webpage`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://addyosmani.com/#person',
      name: 'Addy Osmani',
      url: 'https://addyosmani.com',
      sameAs: ['https://github.com/addyosmani'],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://clarity.addy.ie/#software',
      name: 'Clarity by Addy Osmani',
      alternateName: ['Clarity Agent Skill', 'Clarity Writing Editor'],
      description: productDescription,
      url: 'https://clarity.addy.ie/',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      isAccessibleForFree: true,
      featureList: [
        'Draft, rewrite, review, and interview modes for AI agents',
        'Source-fidelity and authorship safeguards',
        'Medium-aware writing guidance',
        'Private in-browser writing review',
      ],
      license: 'https://opensource.org/license/mit',
      author: { '@id': 'https://addyosmani.com/#person' },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      sameAs: ['https://github.com/addyosmani/clarity'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://clarity.addy.ie/#website',
      name: 'Clarity by Addy Osmani',
      alternateName: 'Clarity',
      url: 'https://clarity.addy.ie/',
      description: productDescription,
      publisher: { '@id': 'https://addyosmani.com/#person' },
      inLanguage: 'en',
    },
    {
      '@type': 'WebPage',
      '@id': pageId,
      name: title,
      description,
      url: canonical.href,
      isPartOf: { '@id': 'https://clarity.addy.ie/#website' },
      about: { '@id': 'https://clarity.addy.ie/#software' },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageUrl.href,
        width: 1200,
        height: 630,
      },
      inLanguage: 'en',
    },
    ...(faqItems.length
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${canonical.href}#faq`,
            isPartOf: { '@id': pageId },
            mainEntity: faqItems.map((item) => ({
              '@type': 'Question',
              name: item.question,
              acceptedAnswer: {
                '@type': 'Answer',
                text: item.answer,
              },
            })),
          },
        ]
      : []),
    ...schemaItems,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={resolvedMarkdownPath} />
    <link rel="describedby" href="/llms.txt" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Clarity by Addy Osmani" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#0c0c0e" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Clarity by Addy Osmani" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="clarity.addy.ie" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@addyosmani" />
    <meta name="twitter:site" content="@addyosmani" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="author" content="Addy Osmani" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a href={skipHref} class="skip-link">{skipLabel}</a>
    <slot />
  </body>
</html>
