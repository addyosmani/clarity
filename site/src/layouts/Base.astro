---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = 'clarity — writing that earns its reader',
  description =
    'Eighteen rules for writing that carries a point of view, and an Agent Skill that applies them when you draft, rewrite, or review prose with a coding agent.',
  ogImage = '/og.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://clarity.addy.ie');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0e" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="clarity" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={new URL(ogImage, canonical)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="clarity — writing that earns its reader. Install with npx skills add addyosmani/clarity" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@addyosmani" />
    <meta name="twitter:site" content="@addyosmani" />
    <meta name="twitter:image" content={new URL(ogImage, canonical)} />
    <meta name="twitter:image:alt" content="clarity — writing that earns its reader. Install with npx skills add addyosmani/clarity" />
    <meta name="author" content="Addy Osmani" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a href="#rules" class="skip-link">Skip to the rules</a>
    <slot />
  </body>
</html>
