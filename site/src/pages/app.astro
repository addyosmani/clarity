---
import EditorApp from "@/components/editor/EditorApp"
import "@/styles/editor.css"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Clarity Writing Editor - clarity.addy.ie</title>
    <meta
      name="description"
      content="A private writing editor for AI writing tells, readability, and Clarity review."
    />
    <meta name="application-name" content="Clarity by Addy Osmani" />
    <meta name="theme-color" content="#fafafa" />
    <link rel="canonical" href="https://clarity.addy.ie/app/" />
    <link rel="alternate" type="text/markdown" href="/app/index.md" />
    <link rel="describedby" href="/llms.txt" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;550;600&family=Geist+Mono:wght@400;500;550&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <EditorApp client:load />
    <noscript>
      <p>This editor needs JavaScript to analyze text locally in your browser.</p>
    </noscript>
  </body>
</html>
