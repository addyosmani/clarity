---
import EditorApp from "@/components/editor/EditorApp"
import "@/styles/editor.css"

const title = "Clarity AI Writing Editor: AI tells and readability"
const description = "Review AI writing tells, readability, repetition, passive voice, and deeper clarity issues in a free private editor that runs in your browser."
const canonical = new URL("/app/", Astro.site ?? "https://clarity.addy.ie")
const ogImage = new URL("/og-editor.png", canonical)
const ogImageAlt = "Clarity Writing Editor with a document editor, pattern score, highlighted prose, and review findings."
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://clarity.addy.ie/app/#application",
  name: "Clarity Writing Editor",
  alternateName: "Clarity AI Writing Editor",
  url: canonical.href,
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript and a modern web browser.",
  isAccessibleForFree: true,
  featureList: [
    "AI writing tell review",
    "Readability and sentence-level analysis",
    "Clarity review prompts",
    "Local draft persistence",
    "Agent editing prompt export",
  ],
  image: ogImage.href,
  author: {
    "@type": "Person",
    name: "Addy Osmani",
    url: "https://addyosmani.com",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  sameAs: "https://github.com/addyosmani/clarity",
  inLanguage: "en",
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Clarity by Addy Osmani" />
    <meta name="author" content="Addy Osmani" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#fafafa" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href="/app/index.md" />
    <link rel="describedby" href="/llms.txt" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Clarity by Addy Osmani" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="clarity.addy.ie" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@addyosmani" />
    <meta name="twitter:site" content="@addyosmani" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;550;600&family=Geist+Mono:wght@400;500;550&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <EditorApp client:load />
    <noscript>
      <p>This editor needs JavaScript to analyze text locally in your browser.</p>
    </noscript>
  </body>
</html>
